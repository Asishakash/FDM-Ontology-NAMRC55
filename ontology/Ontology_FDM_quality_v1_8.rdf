<DimensionOnlyRequirement rdf:about="#Req03">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Req03 - ISO 2768-1 class c (per dimension), no surface requirement</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimensional limits are the ISO 2768-1:1989 coarse-class permissible deviations for the coupon nominal sizes: length 60 mm (over 30-120 mm: +/-0.8 mm), width 10 mm (over 6-30 mm: +/-0.5 mm), height 3 mm (0.5-3 mm: +/-0.2 mm). No Ra limit: the part is a DimensionOnlyRequirement, so rule R1b judges it on dimensions only.</rdfs:comment>
  <intendedUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hidden functional part such as a jig or spacer: general tolerances ISO 2768-1 class c and no top-face finish requirement</intendedUse>
  <requiredMaxLengthDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</requiredMaxLengthDeviation>
  <requiredMaxWidthDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</requiredMaxWidthDeviation>
  <requiredMaxHeightDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</requiredMaxHeightDeviation>
</DimensionOnlyRequirement>

