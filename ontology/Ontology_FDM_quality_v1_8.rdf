<ManufacturingRequirement rdf:about="#Req02">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Req02 - ISO 2768-1 class m (per dimension) + top Ra &lt;= 5.0 um</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimensional limits are the ISO 2768-1:1989 medium-class permissible deviations for the nominal sizes of the coupon: length 60 mm (over 30-120 mm: +/-0.3 mm), width 10 mm (over 6-30 mm: +/-0.2 mm), height 3 mm (0.5-3 mm: +/-0.1 mm). ISO 2768-1 is written primarily for machined parts and is applied here as a reference tolerance. The Ra limit is the study's own illustrative criterion, not taken from a standard.</rdfs:comment>
  <intendedUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fit-check part: general tolerances ISO 2768-1 class m and a smooth top face</intendedUse>
  <requiredMaxLengthDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3</requiredMaxLengthDeviation>
  <requiredMaxWidthDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</requiredMaxWidthDeviation>
  <requiredMaxHeightDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</requiredMaxHeightDeviation>
  <requiredMaxRaValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</requiredMaxRaValue>
</ManufacturingRequirement>

