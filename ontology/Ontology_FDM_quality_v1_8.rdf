      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#evaluatesSetting"/>
              <swrl:argument1 rdf:resource="urn:swrl#e"/>
              <swrl:argument2 rdf:resource="urn:swrl#p"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#forRequirement"/>
                  <swrl:argument1 rdf:resource="urn:swrl#e"/>
                  <swrl:argument2 rdf:resource="urn:swrl#q"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#recommendsSettingFor"/>
          <swrl:argument1 rdf:resource="urn:swrl#p"/>
          <swrl:argument2 rdf:resource="urn:swrl#q"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#recommendsParameterSetting"/>
              <swrl:argument1 rdf:resource="urn:swrl#e"/>
              <swrl:argument2 rdf:resource="urn:swrl#p"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R7_Recommend</rdfs:label>
</swrl:Imp>

<swrl:Variable rdf:about="urn:swrl#p"/>

<ManufacturingRequirement rdf:about="#Req01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Req01 - illustrative single limit (|dev| &lt;= 0.50 mm on every dimension, top Ra &lt;= 5.0 um)</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Illustrative acceptance requirement used in the NAMRC 55 study. A limit of 0.50 mm on every dimension is equivalent to MaxAbsDev &lt;= 0.50 mm. The Ra limit is the study's own criterion; ISO 21920-2 defines Ra but sets no acceptance value.</rdfs:comment>
  <intendedUse rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Visible coarse part: every dimension within 0.50 mm and a smooth top face</intendedUse>
  <requiredMaxLengthDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</requiredMaxLengthDeviation>
  <requiredMaxWidthDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</requiredMaxWidthDeviation>
  <requiredMaxHeightDeviation rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</requiredMaxHeightDeviation>
  <requiredMaxRaValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</requiredMaxRaValue>
</ManufacturingRequirement>

