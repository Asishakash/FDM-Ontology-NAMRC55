<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.wcu.edu/ontology/fdm-quality"
         xmlns="http://www.wcu.edu/ontology/fdm-quality#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://www.wcu.edu/ontology/fdm-quality">
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDM process-parameter-based quality classification ontology, version 1.8 (v1.8: the nominal closure of v1.7 is replaced by a coversAssessment max-cardinality axiom and rules R8/R9, which infer ProcessRecommendation and NotRecommendedSetting; decision-support layer: three application profiles Req01-Req03, a dimension-only requirement class with rule R1b, and PrusaSlicer print-time and filament estimates per setting for ranking; the ranking, closest-miss and suitability queries are in fdm_dss.py). Populated from a replicated Taguchi L9 experiment on PLA (18 specimens). Each result is judged against each requirement through a QualityAssessment, so several requirements coexist; SWRL rules R1-R5 read all limits from the requirement individuals and infer the outcome and the exceeded characteristic. Setting evaluations carry a max-cardinality axiom over the printed replicates; R8 infers ProcessRecommendation (both replicates acceptable) and R9 NotRecommendedSetting (at least one defective replicate). Numeric values are xsd:decimal. Top-face Ra values were re-evaluated from the raw profiles at ISO 21920-3 setting class Sc4 (lc 2.5 mm, ln 12.5 mm), the class that applies to a 5 um Ra limit; S01 keeps its reported value because its raw profile was not supplied. Defect classes and tensileStrengthValue are placeholders: no defect inspection or tensile testing was performed.</rdfs:comment>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.8</owl:versionInfo>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDM Process-Parameter-Based Quality Classification Ontology</rdfs:label>
</owl:Ontology>

<owl:ObjectProperty rdf:about="#usesProcess">
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="#AMProcess"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#usesMaterial">
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="#Material"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasParameterSetting">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Specimen"/>
  <rdfs:range rdf:resource="#ParameterSetting"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#printedOnMachine">
  <rdfs:domain rdf:resource="#Specimen"/>
  <rdfs:range rdf:resource="#Machine"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasResult">
  <rdfs:domain rdf:resource="#Specimen"/>
  <rdfs:range rdf:resource="#ExperimentalResult"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasQualityCharacteristic">
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="#QualityCharacteristic"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exhibitsDefect">
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="#Defect"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#meetsRequirement">
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="#ManufacturingRequirement"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#assessesResult">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#QualityAssessment"/>
  <rdfs:range rdf:resource="#ExperimentalResult"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#againstRequirement">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#QualityAssessment"/>
  <rdfs:range rdf:resource="#ManufacturingRequirement"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#hasOutcome">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#QualityAssessment"/>
  <rdfs:range rdf:resource="#QualityClass"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#exceedsLimitOf">
  <rdfs:domain rdf:resource="#QualityAssessment"/>
  <rdfs:range rdf:resource="#QualityCharacteristic"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#evaluatesSetting">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#SettingEvaluation"/>
  <rdfs:range rdf:resource="#ParameterSetting"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#forRequirement">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#SettingEvaluation"/>
  <rdfs:range rdf:resource="#ManufacturingRequirement"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#coversAssessment">
  <rdfs:domain rdf:resource="#SettingEvaluation"/>
  <rdfs:range rdf:resource="#QualityAssessment"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recommendsParameterSetting">
  <rdfs:domain rdf:resource="#ProcessRecommendation"/>
  <rdfs:range rdf:resource="#ParameterSetting"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#recommendsSettingFor">
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="#ManufacturingRequirement"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#parameterSettingID">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Identifier of the L9 run.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#layerHeightValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Layer height, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#firstLayerSpeedValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">First-layer speed set in PrusaSlicer, mm/s. All other speeds were identical in every run.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#infillPercentageValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Infill density, %.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#specimenID">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Specimen"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specimen identifier.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#lengthDeviationValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Signed length deviation, measured mean minus 60 mm nominal, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#widthDeviationValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Signed width deviation, measured mean minus 10 mm nominal, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#heightDeviationValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Signed height deviation, measured mean minus 3 mm nominal, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#absLengthDeviationValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">|lengthDeviationValue|, mm (stored so the rules need no arithmetic built-in).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#absWidthDeviationValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">|widthDeviationValue|, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#absHeightDeviationValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">|heightDeviationValue|, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#dimensionalDeviationValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum absolute deviation over length, width and height (MaxAbsDev), mm. Derived; not used by the rules.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#surfaceRoughnessRaValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Top-face Ra, um. v1.6: one profile along the 60 mm axis, 2nd-order form removal, Gaussian filter lc 2.5 mm, evaluation length 12.5 mm centred on 30 mm (ISO 21920-3 setting Sc4). See each result comment for the source.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#requiredMaxLengthDeviation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManufacturingRequirement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum permitted |length deviation|, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#requiredMaxWidthDeviation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManufacturingRequirement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum permitted |width deviation|, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#requiredMaxHeightDeviation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManufacturingRequirement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum permitted |height deviation|, mm.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#requiredMaxRaValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManufacturingRequirement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Maximum permitted top-face Ra, um.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#intendedUse">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ManufacturingRequirement"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Application profile the requirement stands for.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#estimatedPrintTimeValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PrusaSlicer 2.9.6 estimated printing time for one coupon, normal mode, s (from the G-code of the run).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#estimatedFilamentMassValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ParameterSetting"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PrusaSlicer 2.9.6 estimated filament used for one coupon, g (from the G-code of the run).</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#tensileStrengthValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#ExperimentalResult"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Placeholder; not measured in this study, MPa.</rdfs:comment>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#defectSeverityValue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Defect"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Placeholder; no defect inspection performed.</rdfs:comment>
</owl:DatatypeProperty>

<owl:Class rdf:about="#AMProcess">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Material">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Machine">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ProcessParameter">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#LayerHeight">
  <rdfs:subClassOf rdf:resource="#ProcessParameter"/>
</owl:Class>

<owl:Class rdf:about="#PrintSpeed">
  <rdfs:subClassOf rdf:resource="#ProcessParameter"/>
</owl:Class>

<owl:Class rdf:about="#InfillPercentage">
  <rdfs:subClassOf rdf:resource="#ProcessParameter"/>
</owl:Class>

<owl:Class rdf:about="#ParameterSetting">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Specimen">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ExperimentalResult">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#QualityCharacteristic">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#DimensionalAccuracy">
  <rdfs:subClassOf rdf:resource="#QualityCharacteristic"/>
</owl:Class>

<owl:Class rdf:about="#SurfaceQuality">
  <rdfs:subClassOf rdf:resource="#QualityCharacteristic"/>
</owl:Class>

<owl:Class rdf:about="#Defect">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Warping">
  <rdfs:subClassOf rdf:resource="#Defect"/>
</owl:Class>

<owl:Class rdf:about="#Stringing">
  <rdfs:subClassOf rdf:resource="#Defect"/>
</owl:Class>

<owl:Class rdf:about="#LayerDelamination">
  <rdfs:subClassOf rdf:resource="#Defect"/>
</owl:Class>

<owl:Class rdf:about="#UnderExtrusion">
  <rdfs:subClassOf rdf:resource="#Defect"/>
</owl:Class>

<owl:Class rdf:about="#ManufacturingRequirement">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#DimensionOnlyRequirement">
  <rdfs:subClassOf rdf:resource="#ManufacturingRequirement"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:complementOf>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#requiredMaxRaValue"/>
          <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        </owl:Restriction>
      </owl:complementOf>
    </owl:Class>
  </rdfs:subClassOf>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A requirement that sets dimensional limits only; it may not carry a top-face Ra limit (asserting one makes the ontology inconsistent). Judged by rule R1b.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#QualityClass">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Acceptable">
  <rdfs:subClassOf rdf:resource="#QualityClass"/>
  <owl:disjointWith rdf:resource="#Defective"/>
</owl:Class>

<owl:Class rdf:about="#Defective">
  <rdfs:subClassOf rdf:resource="#QualityClass"/>
</owl:Class>

<owl:Class rdf:about="#QualityAssessment">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#SettingEvaluation">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ProcessRecommendation">
  <rdfs:subClassOf rdf:resource="#SettingEvaluation"/>
  <owl:disjointWith rdf:resource="#NotRecommendedSetting"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred by rule R8: a two-replicate setting evaluation whose two different covered assessments are both Acceptable. With coversAssessment max 2 these are all of its assessments.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#NotRecommendedSetting">
  <rdfs:subClassOf rdf:resource="#SettingEvaluation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inferred by rule R9: a setting evaluation that covers a Defective assessment.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TwoReplicateEvaluation">
  <rdfs:subClassOf rdf:resource="#SettingEvaluation"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A setting evaluation over exactly two printed replicates (asserted with a coversAssessment max 2 axiom on the individual).</rdfs:comment>
</owl:Class>

<AMProcess rdf:about="#FDM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">FDM</rdfs:label>
</AMProcess>

<Material rdf:about="#PLA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PLA (Overture, white, 1.75 mm, single batch)</rdfs:label>
</Material>

<Machine rdf:about="#Printer01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prusa MK4S, 0.8 mm nozzle</rdfs:label>
</Machine>

<Acceptable rdf:about="#Acceptable_Instance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acceptable</rdfs:label>
</Acceptable>

<Defective rdf:about="#Defective_Instance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defective</rdfs:label>
</Defective>

<DimensionalAccuracy rdf:about="#DimAccuracy_Instance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimensional accuracy (overall)</rdfs:label>
</DimensionalAccuracy>

<DimensionalAccuracy rdf:about="#LengthAccuracy_Instance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Length accuracy</rdfs:label>
</DimensionalAccuracy>

<DimensionalAccuracy rdf:about="#WidthAccuracy_Instance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Width accuracy</rdfs:label>
</DimensionalAccuracy>

<DimensionalAccuracy rdf:about="#HeightAccuracy_Instance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Height accuracy</rdfs:label>
</DimensionalAccuracy>

<SurfaceQuality rdf:about="#SurfaceQuality_Instance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Surface quality (top-face Ra)</rdfs:label>
</SurfaceQuality>

<ParameterSetting rdf:about="#PS01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <usesProcess rdf:resource="#FDM"/>
  <usesMaterial rdf:resource="#PLA"/>
  <parameterSettingID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PS01</parameterSettingID>
