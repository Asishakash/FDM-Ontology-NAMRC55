<SettingEvaluation rdf:about="#SettingEval_PS01_Req01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <evaluatesSetting rdf:resource="#PS01"/>
  <forRequirement rdf:resource="#Req01"/>
  <coversAssessment rdf:resource="#Assessment_S01_Req01"/>
  <coversAssessment rdf:resource="#Assessment_S02_Req01"/>
  <rdf:type>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#coversAssessment"/>
      <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:maxCardinality>
    </owl:Restriction>
  </rdf:type>
  <rdf:type rdf:resource="#TwoReplicateEvaluation"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Evaluation of PS01 against Req01 (2 replicates)</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cardinality axiom: the experiment printed exactly 2 replicates of PS01; the evaluation covers at most 2 assessments, so the 2 asserted (pairwise different) assessments are all of them.</rdfs:comment>
</SettingEvaluation>

